# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mullen_analytics
DATABASE_POOL_SIZE=10
# AWS/ECS alternative: prefer discrete fields so Secrets Manager can inject
# passwords without placing a full credential-bearing DSN in task definitions.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=mullen_analytics
DATABASE_USER=app_user
DATABASE_PASSWORD=
DATABASE_ADMIN_USER=mullen_admin
DATABASE_ADMIN_PASSWORD=
DATABASE_SSLMODE=require

# Auth - CHANGE THESE IN PRODUCTION
SECRET_KEY=change-this-use-openssl-rand-hex-32-to-generate
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Password Reset
PASSWORD_RESET_EXPIRE_HOURS=1

# Email (for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@mullenanalytics.com
SMTP_FROM_NAME=Mullen Analytics

# Storage
STORAGE_PROVIDER=s3
# ECS uses its task role; do not configure static AWS keys in production.
# Local development may use a named AWS profile or short-lived credentials.
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=

# Durable processing (AWS ECS/SQS). Keep background for local/Railway.
JOB_BACKEND=background
# PIPELINE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/mullen-pipeline
# JOB_VISIBILITY_TIMEOUT_SECONDS=900

# GCS (when ready to migrate)
# GCS_BUCKET=your-gcs-bucket
# GCS_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
DEBUG=false
# Keep false until the PHI production release gate is approved.
PHI_INGESTION_ENABLED=false

# Required for Cognito mode: provision a separate secret for the Super Admin role.
# Existing ECS tasks must be updated to inject this before deploying migration 018.
PLATFORM_DB_USER=app_platform
PLATFORM_DB_PASSWORD=
# Optional API DSN override; the migration task still requires PLATFORM_DB_PASSWORD.
PLATFORM_DATABASE_URL=
