# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mullen_analytics
DATABASE_POOL_SIZE=10

# Auth - CHANGE THESE IN PRODUCTION
SECRET_KEY=change-this-use-openssl-rand-hex-32-to-generate
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Password Reset
PASSWORD_RESET_EXPIRE_HOURS=1

# Email (for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@mullenanalytics.com
SMTP_FROM_NAME=Mullen Analytics

# Storage
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Durable processing (AWS ECS/SQS). Keep background for local/Railway.
JOB_BACKEND=background
# PIPELINE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/mullen-pipeline
# JOB_VISIBILITY_TIMEOUT_SECONDS=900

# GCS (when ready to migrate)
# GCS_BUCKET=your-gcs-bucket
# GCS_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
DEBUG=false
