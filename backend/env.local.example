# Copy this to backend/.env for local development
# DO NOT commit .env files

ENVIRONMENT=local
STORAGE_BACKEND=local
JOB_BACKEND=background

# Local PostgreSQL (create DB: createdb mullen_analytics_local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mullen_analytics

# File storage — local directories (created automatically)
DATA_UPLOADS_ROOT=./local_data/uploads
DATA_STORAGE_ROOT=./local_data/storage

# Auth (any random string for local dev)
SECRET_KEY=local-dev-secret-key-change-for-production
SESSION_COOKIE_SECURE=false

# Email (leave blank to skip email sending locally)
SENDGRID_API_KEY=
SMTP_FROM_EMAIL=noreply@localhost
SMTP_FROM_NAME=Mullen Analytics Dev

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:8001
